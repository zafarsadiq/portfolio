From 4c58e7b198b8c74e3e9c12f0f8a1b562d994f930 Mon Sep 17 00:00:00 2001
From: Zafar Sadiq <2jafor@gmail.com>
Date: Wed, 11 Nov 2026 12:37:27 +0000
Subject: [PATCH] Full-width About intro and mobile burger menu

---
 components/About.tsx        |  2 +-
 components/Nav.tsx          | 58 +++++++++++++++++++++++++++++++++++--
 components/SectionTitle.tsx |  4 +--
 3 files changed, 58 insertions(+), 6 deletions(-)

diff --git a/components/About.tsx b/components/About.tsx
index 4d681cf..ac0e962 100644
--- a/components/About.tsx
+++ b/components/About.tsx
@@ -9,7 +9,7 @@ const cards = [
 export default function About() {
   return (
     <section id="about" className="pb-16">
-      <SectionTitle sub="I’m a full-stack engineer based in Bangladesh with a Computer Science degree from East West University. I started in 2010 at eBizzSol, worked across several teams in Dhaka, and spent nearly ten years as Lead Web Developer at 79mplus (2017–2026). I’m now looking for a role where I can put these skills to work.">
+      <SectionTitle wide sub="I’m a full-stack engineer based in Bangladesh with a Computer Science degree from East West University. I started in 2010 at eBizzSol, worked across several teams in Dhaka, and spent nearly ten years as Lead Web Developer at 79mplus (2017–2026). I’m now looking for a role where I can put these skills to work.">
         Who am I?
       </SectionTitle>
       <div className="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-4">
diff --git a/components/Nav.tsx b/components/Nav.tsx
index 0616954..77df030 100644
--- a/components/Nav.tsx
+++ b/components/Nav.tsx
@@ -1,20 +1,72 @@
+"use client";
+
+import { useEffect, useState } from "react";
 import { nav } from "@/lib/data";
 
 export default function Nav() {
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    if (!open) return;
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape") setOpen(false);
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [open]);
+
   return (
     <header className="sticky top-[env(safe-area-inset-top,0px)] z-50 bg-bg/95 backdrop-blur">
-      <nav className="mx-auto flex max-w-[1000px] items-center justify-between gap-3.5 px-5 py-3 md:py-[18px]">
-        <a href="#top" className="whitespace-nowrap font-display text-[1.1rem] font-bold tracking-wide md:text-[1.3rem]">
+      <nav aria-label="Main" className="mx-auto flex max-w-[1000px] items-center justify-between gap-3.5 px-5 py-3 md:py-[18px]">
+        <a
+          href="#top"
+          onClick={() => setOpen(false)}
+          className="whitespace-nowrap font-display text-[1.1rem] font-bold tracking-wide md:text-[1.3rem]"
+        >
           ZAFAR<span className="text-accent">.</span>SADIQ
         </a>
-        <div className="flex min-w-0 gap-3.5 overflow-x-auto text-[.85rem] [scrollbar-width:none] md:gap-[18px] [&::-webkit-scrollbar]:hidden">
+
+        {/* Desktop links */}
+        <div className="hidden gap-[18px] text-[.85rem] md:flex">
           {nav.map((n) => (
             <a key={n.href} href={n.href} className="whitespace-nowrap text-muted transition hover:text-accent">
               {n.label}
             </a>
           ))}
         </div>
+
+        {/* Mobile burger button */}
+        <button
+          type="button"
+          aria-label={open ? "Close menu" : "Open menu"}
+          aria-expanded={open}
+          aria-controls="mobile-menu"
+          onClick={() => setOpen((v) => !v)}
+          className="-mr-2 inline-flex h-10 w-10 items-center justify-center rounded-lg text-[#f2f2f2] transition hover:text-accent md:hidden"
+        >
+          <svg viewBox="0 0 24 24" aria-hidden="true" className="h-6 w-6 fill-none stroke-current" strokeWidth="2" strokeLinecap="round">
+            {open ? <path d="M6 6l12 12M18 6L6 18" /> : <path d="M4 7h16M4 12h16M4 17h16" />}
+          </svg>
+        </button>
       </nav>
+
+      {/* Mobile menu panel */}
+      {open && (
+        <div id="mobile-menu" className="absolute inset-x-0 top-full border-t border-line bg-bg shadow-[0_12px_24px_rgba(0,0,0,.35)] md:hidden">
+          <div className="mx-auto flex max-w-[1000px] flex-col px-5 py-2">
+            {nav.map((n) => (
+              <a
+                key={n.href}
+                href={n.href}
+                onClick={() => setOpen(false)}
+                className="border-b border-line py-3.5 text-[1rem] font-medium text-muted last:border-b-0 hover:text-accent"
+              >
+                {n.label}
+              </a>
+            ))}
+          </div>
+        </div>
+      )}
     </header>
   );
 }
diff --git a/components/SectionTitle.tsx b/components/SectionTitle.tsx
index 6f27521..1a93680 100644
--- a/components/SectionTitle.tsx
+++ b/components/SectionTitle.tsx
@@ -1,10 +1,10 @@
-export default function SectionTitle({ children, sub }: { children: React.ReactNode; sub?: string }) {
+export default function SectionTitle({ children, sub, wide }: { children: React.ReactNode; sub?: string; wide?: boolean }) {
   return (
     <>
       <h2 className="font-display text-[clamp(1.9rem,6vw,2.6rem)] font-medium uppercase leading-[1.1] after:mt-2.5 after:block after:h-1 after:w-14 after:rounded-sm after:bg-accent">
         {children}
       </h2>
-      {sub && <p className="mb-6 mt-3.5 max-w-[620px] text-muted">{sub}</p>}
+      {sub && <p className={`mb-6 mt-3.5 text-muted ${wide ? "w-full" : "max-w-[620px]"}`}>{sub}</p>}
     </>
   );
 }
-- 
2.43.0

